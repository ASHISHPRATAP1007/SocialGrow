# ---- Required ----
# Neon / Render Postgres URL. Leave empty locally to use a SQLite file (socialgrow.db).
DATABASE_URL=
# Long random string (min 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Your frontend URL(s), comma separated
CORS_ORIGINS=http://localhost:3000
# This backend's public URL (used to show the Razorpay webhook URL in Admin Panel)
PUBLIC_API_URL=http://localhost:8000

# ---- AI (free: Google Gemini) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free backups (used automatically when the main AI is slow/down — add any you have):
#   Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
#   OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional paid alternatives: OPENAI_API_KEY, ANTHROPIC_API_KEY (AI_PROVIDER picks which one is tried first)

# ---- Password reset email (optional, e.g. Gmail + App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Background jobs ----
ENABLE_SCHEDULER=true
# Secret for the free external cron (cron-job.org) — any random string
CRON_SECRET=
